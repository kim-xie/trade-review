# 站点正式地址（不要以 / 结尾）。所有 canonical / sitemap / robots / Open Graph / JSON-LD 都从这里读取。
# 例：https://trade-review.vercel.app 或 https://trade-review.pages.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Tushare（A 股 K 线，用户自带 token）----------
# 浏览器端使用的 Tushare 透传代理地址。
# - Vercel / next start：留空即可，默认使用同源 /api/tushare（src/app/api/tushare/route.proxy.ts）。
# - 静态导出（build:static / Cloudflare Pages）：没有服务端路由，必须部署 workers/tushare-proxy 并填写其地址。
NEXT_PUBLIC_TUSHARE_PROXY_URL=

# 仅 Next.js 路由代理使用（服务端变量）：额外允许的来源（逗号分隔）；同源与 NEXT_PUBLIC_SITE_URL 默认允许。
TUSHARE_PROXY_ALLOWED_ORIGINS=
# 每个 IP 每分钟最多请求数（内存计数，单实例有效）
TUSHARE_PROXY_RATE_PER_MIN=60
